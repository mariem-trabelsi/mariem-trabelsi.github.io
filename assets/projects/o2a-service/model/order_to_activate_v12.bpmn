      <incoming>_sC06</incoming>
      <outgoing>Flow_C_DOSSIER_TO_END</outgoing>
      <ioSpecification>
        <dataInput id="_C_THROW_DOSSIER_CLOSED_msgInput" name="Message" itemSubjectRef="_msgItem_DossierClosed" />
        <inputSet><dataInputRefs>_C_THROW_DOSSIER_CLOSED_msgInput</dataInputRefs></inputSet>
      </ioSpecification>
      <dataInputAssociation><sourceRef>orderId</sourceRef><targetRef>_C_THROW_DOSSIER_CLOSED_msgInput</targetRef></dataInputAssociation>
      <signalEventDefinition signalRef="_signal_DossierClosedInternal" />
    </intermediateThrowEvent>
    <endEvent id="_C_END_DOSSIER_CLOSED" name="Fin Dossier client clos processus termine">
      <incoming>Flow_C_DOSSIER_TO_END</incoming>
    </endEvent>

    <userTask id="_C_TASK_VERIFY_SATISFACTION" name="Enquete satisfaction client NPS automatique" drools:taskName="VerifSatisfaction" drools:groupId="customer-success">
      <incoming>_sC05</incoming>
      <outgoing>_sC06</outgoing>
      <ioSpecification>
        <dataInput id="_C_TASK_VERIFY_SATISFACTION_TaskNameInput" name="TaskName" itemSubjectRef="_taskNameItem" />
        <!-- Sans dataOutput declare, la tache ignore SILENCIEUSEMENT ce que le
             portail lui renvoie : le score et le commentaire etaient saisis par
             le client puis perdus. Rien ne les stockait nulle part. -->
        <dataOutput id="_C_TASK_VERIFY_SATISFACTION_npsScore" name="npsScore" itemSubjectRef="_npsScoreItem" />
        <dataOutput id="_C_TASK_VERIFY_SATISFACTION_npsComment" name="satisfactionComment" itemSubjectRef="_npsCommentItem" />
        <inputSet><dataInputRefs>_C_TASK_VERIFY_SATISFACTION_TaskNameInput</dataInputRefs></inputSet>
        <outputSet>
          <dataOutputRefs>_C_TASK_VERIFY_SATISFACTION_npsScore</dataOutputRefs>
          <dataOutputRefs>_C_TASK_VERIFY_SATISFACTION_npsComment</dataOutputRefs>
        </outputSet>
      </ioSpecification>
      <dataInputAssociation>
        <targetRef>_C_TASK_VERIFY_SATISFACTION_TaskNameInput</targetRef>
        <assignment>
          <from xsi:type="tFormalExpression">VerifSatisfaction</from>
          <to xsi:type="tFormalExpression">_C_TASK_VERIFY_SATISFACTION_TaskNameInput</to>
        </assignment>
      </dataInputAssociation>
      <dataOutputAssociation>
        <sourceRef>_C_TASK_VERIFY_SATISFACTION_npsScore</sourceRef>
        <targetRef>npsScore</targetRef>
      </dataOutputAssociation>
      <dataOutputAssociation>
        <sourceRef>_C_TASK_VERIFY_SATISFACTION_npsComment</sourceRef>
        <targetRef>satisfactionComment</targetRef>
      </dataOutputAssociation>
    </userTask>

    <intermediateCatchEvent id="_C_CATCH_ACTIVATION" name="Recevoir confirmation activation email SMS">
      <incoming>_sC04</incoming>
      <outgoing>_sC05</outgoing>
      <ioSpecification>
        <dataOutput id="_C_CATCH_ACTIVATION_msgOutput" name="Message" itemSubjectRef="_msgItem_ActivationNotifiedSub" />
        <outputSet><dataOutputRefs>_C_CATCH_ACTIVATION_msgOutput</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation><sourceRef>_C_CATCH_ACTIVATION_msgOutput</sourceRef><targetRef>activationNotifiedPayload</targetRef></dataOutputAssociation>
      <!-- FIX root-cause 2026-08-03: was messageRef="_msg_ActivationNotified" (same as the
           throw event) -> Kogito could never bind an incoming channel for this catch event,
           it stayed Active forever. Now bound to the dedicated Sub message, wired via
           mp.messaging.incoming.ActivationNotifiedSub in application.properties. -->
      <signalEventDefinition signalRef="_signal_ActivationNotifiedInternal" />
    </intermediateCatchEvent>

    <intermediateThrowEvent id="_C_THROW_RDV_CONFIRMED" name="Publier RdvConfirme espace client ou telephone">
