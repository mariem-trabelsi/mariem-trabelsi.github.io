    <!-- ===== BOUNDARY EVENTS (Compensation) ===== -->
    <boundaryEvent id="_O_COMP_ORDER" name="Compenser ProductOrder" attachedToRef="_O_TASK_CREATE_PRODUCT_ORDER">
      <compensateEventDefinition />
    </boundaryEvent>
    <task id="_O_TASK_CANCEL_PRODUCT_ORDER" name="Annuler le ProductOrder TMF622 DELETE" isForCompensation="true" drools:taskName="ProductOrderService_cancelProductOrder" />

    <boundaryEvent id="_A_COMP_WORKORDER" name="Compenser WorkOrder" attachedToRef="_A_TASK_CREATE_WORK_ORDER">
      <compensateEventDefinition />
    </boundaryEvent>
    <task id="_A_TASK_CANCEL_WORK_ORDER" name="Annuler le WorkOrder TMF697" isForCompensation="true" drools:taskName="WorkOrderService_cancelWorkOrder" />

    <boundaryEvent id="_A_COMP_RESERVATION" name="Compenser reservation port" attachedToRef="_A_TASK_GET_NETWORK_CONTEXT">
      <compensateEventDefinition />
    </boundaryEvent>
    <boundaryEvent id="_A_COMP_NETWORK" name="Compenser provisioning" attachedToRef="_A_TASK_PROVISION_NETWORK">
      <compensateEventDefinition />
    </boundaryEvent>
    <task id="_A_TASK_RELEASE_RESERVED_PORT" name="Liberer le port reserve TMF639 rollback" isForCompensation="true" drools:taskName="ResourceInventoryService_releaseReservation" />
    <task id="_A_TASK_RESTORE_NETWORK" name="Restaurer configuration reseau TMF641 rollback" isForCompensation="true" drools:taskName="NetworkProvisioningService_rollbackProvisioning" />

    <boundaryEvent id="_B_COMP_BILLING_ACCOUNT" name="Compenser compte facturation" attachedToRef="_B_TASK_CREATE_BILLING_ACCOUNT">
      <compensateEventDefinition />
    </boundaryEvent>
    <boundaryEvent id="_B_COMP_INVOICE" name="Compenser envoi facture" attachedToRef="_B_TASK_SEND_FIRST_INVOICE">
      <compensateEventDefinition />
    </boundaryEvent>
    <task id="_B_TASK_CANCEL_INVOICE" name="Annuler la facture envoyee rollback TMF666" isForCompensation="true" drools:taskName="BillingAccountService_cancelFirstInvoice" />
    <task id="_B_TASK_CANCEL_BILLING_ACCOUNT" name="Annuler le compte facturation rollback TMF666 Kill Bill" isForCompensation="true" drools:taskName="BillingAccountService_cancelBillingAccount">
      <!-- Cette tache n'avait AUCUNE `ioSpecification` : son handler recevait
           donc `subscriptionId` vide, et annulait l'abonnement porte par la
           ligne locale du compte. Or un compte de facturation est PARTAGE par
           toutes les commandes d'un client, et une commande compensee avant
           `_B_TASK_ACTIVATE_BILLING` n'a pas d'abonnement a elle : la ligne
           portait celui d'une commande PRECEDENTE, livree et facturee. Mesure :
           fibre active, abonnement annule, facture creditee de -10,297 TND.
           L'abonnement de CETTE instance est desormais transmis, et le handler
           n'annule que s'il existe. -->
      <ioSpecification>
        <dataInput id="_B_TASK_CANCEL_BILLING_ACCOUNT_orderIdInput" name="orderId" itemSubjectRef="_orderIdItem"/>
        <dataInput id="_B_TASK_CANCEL_BILLING_ACCOUNT_billingAccountIdInput" name="billingAccountId" itemSubjectRef="_billingAccountIdItem"/>
        <dataInput id="_B_TASK_CANCEL_BILLING_ACCOUNT_subscriptionIdInput" name="subscriptionId" itemSubjectRef="_orderIdItem"/>
        <inputSet>
          <dataInputRefs>_B_TASK_CANCEL_BILLING_ACCOUNT_orderIdInput</dataInputRefs>
          <dataInputRefs>_B_TASK_CANCEL_BILLING_ACCOUNT_billingAccountIdInput</dataInputRefs>
          <dataInputRefs>_B_TASK_CANCEL_BILLING_ACCOUNT_subscriptionIdInput</dataInputRefs>
        </inputSet>
        <outputSet/>
      </ioSpecification>
      <dataInputAssociation><sourceRef>orderId</sourceRef><targetRef>_B_TASK_CANCEL_BILLING_ACCOUNT_orderIdInput</targetRef></dataInputAssociation>
      <dataInputAssociation><sourceRef>billingAccountId</sourceRef><targetRef>_B_TASK_CANCEL_BILLING_ACCOUNT_billingAccountIdInput</targetRef></dataInputAssociation>
      <dataInputAssociation><sourceRef>subscriptionId</sourceRef><targetRef>_B_TASK_CANCEL_BILLING_ACCOUNT_subscriptionIdInput</targetRef></dataInputAssociation>
    </task>

    <!-- ===== SEQUENCE FLOWS (BILLING) ===== -->
    <sequenceFlow id="_sB_eInv2" sourceRef="_B_CT_INVOICE" targetRef="_B_END_ERR_INVOICE" />
    <sequenceFlow id="_sB_eInv" sourceRef="_B_ERR_INVOICE" targetRef="_B_CT_INVOICE" />
    <sequenceFlow id="_sB06" sourceRef="_B_TASK_SEND_FIRST_INVOICE" targetRef="_B_THROW_BILLING_ACTIVATED" />
    <sequenceFlow id="_sB05" sourceRef="_B_TASK_ACTIVATE_BILLING" targetRef="_B_TASK_SEND_FIRST_INVOICE" />
    <!-- FIX (root-cause, 2026-08-06): third checkpoint. The billing lane
         itself, CreateBillingAccount -> RegisterPayment ->
         ApplyOfferPricingDRL -> ActivateBilling -> SendFirstInvoice ->
         throw BillingActivated -> END, is a further 5-node unbroken
         synchronous run. Splitting it here (after the account/payment/price
         are resolved, before the Kill Bill subscription + invoice calls)
         keeps every remaining segment short enough that a single retry of
         this timer's job re-executes at most 3 WorkItemNodes instead of the
         whole lane. -->
    <sequenceFlow id="_sB04" sourceRef="_B_TASK_APPLY_OFFER_PRICING_DRL" targetRef="_B_TASK_ACTIVATE_BILLING" />
    <sequenceFlow id="_sB03" sourceRef="_B_TASK_REGISTER_PAYMENT" targetRef="_B_TASK_APPLY_OFFER_PRICING_DRL" />
    <sequenceFlow id="_sB02" sourceRef="_B_TASK_CREATE_BILLING_ACCOUNT" targetRef="_B_GW_PAYMENT_MERGE" />
    <!-- FIX (root-cause, 2026-08-06): second checkpoint. Confirmed via real
         test runs that even after Checkpoint #1, the chain
         Extract -> Provision -> Verify -> UpdateServiceInv -> UpdateResourceInv
         -> Join -> [throw SO state change] -> CreateBillingAccount -> ...
         is still one unbroken synchronous run long enough to retrigger the
         Kogito "null source" / setPhaseId marshalling bug, just further
         downstream. This checkpoint yields right at the natural seam between
         the assurance segment (now proven to persist cleanly on its own)
         and the billing segment, so each gets its own clean checkpoint. -->
    <sequenceFlow id="_sA_to_Billing" sourceRef="_A_THROW_SO_STATE_CHANGE" targetRef="_B_TASK_CREATE_BILLING_ACCOUNT" />
    <sequenceFlow id="Flow_B_GW_TO_PAYMENT" sourceRef="_B_GW_PAYMENT_MERGE" targetRef="_B_TASK_REGISTER_PAYMENT" />
    <sequenceFlow id="_sB_ePrice" sourceRef="_B_ERR_PRICING" targetRef="_B_CT_PRICING" />
    <sequenceFlow id="_sB_ePrice2" sourceRef="_B_CT_PRICING" targetRef="_B_END_ERR_PRICING" />
    <sequenceFlow id="Flow_0h2pqbd" sourceRef="_B_THROW_BILLING_ACTIVATED" targetRef="_B_END_BILLING_DONE" />

    <!-- ===== FIXED GATEWAY AUTO 003 ===== -->
    <exclusiveGateway id="_GW_AUTO_003" name="retryCount lt 3" gatewayDirection="Diverging">
      <incoming>Flow_1aid9rl</incoming>
      <outgoing>Flow_1mhvniv</outgoing>
      <outgoing>Flow_1fraxbs</outgoing>
      
    </exclusiveGateway>

    <sequenceFlow id="Flow_1aid9rl" sourceRef="_B_ERR_PAYMENT" targetRef="_GW_AUTO_003" />
    
    <sequenceFlow id="Flow_1mhvniv" name="Abandon" sourceRef="_GW_AUTO_003" targetRef="_O_TASK_ABANDON_ORDER">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java"><![CDATA[return billingRetryCount != null && ((Integer)billingRetryCount) >= 3;]]></conditionExpression>
    </sequenceFlow>
    
    <sequenceFlow id="Flow_1fraxbs" name="Tentative suivante" sourceRef="_GW_AUTO_003" targetRef="_B_TASK_INCREMENT_BILLING_RETRY">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java"><![CDATA[return billingRetryCount == null || ((Integer)billingRetryCount) < 3;]]></conditionExpression>
    </sequenceFlow>
    
  

    <task id="_O_TASK_ABANDON_ORDER" name="Cloturer la commande abandonnee paiement" drools:taskName="OrderService_abandonOrder">
      <!-- La cloture normale est gardee par le join _GW_AUTO_002, qui attend
           BillingActivated. Paiement abandonne = evenement jamais publie = join
           jamais satisfait = _O_TASK_CLOSE_ORDER jamais execute. Or c'est lui
           qui relache hasActiveOrder : sans cette tache, le client reste bloque
           par R-ORD-004 sans qu'aucun parcours ne puisse le liberer. -->
      <incoming>Flow_1mhvniv</incoming>
      <outgoing>Flow_abandon_end</outgoing>
      <ioSpecification>
        <dataInput id="_O_TASK_ABANDON_ORDER_orderIdInput" name="orderId" itemSubjectRef="_orderIdItem"/>
        <dataInput id="_O_TASK_ABANDON_ORDER_productOrderIdInput" name="productOrderId" itemSubjectRef="_productOrderIdItem"/>
        <dataInput id="_O_TASK_ABANDON_ORDER_customerIdInput" name="customerId" itemSubjectRef="_customerIdItem"/>
        <inputSet>
          <dataInputRefs>_O_TASK_ABANDON_ORDER_orderIdInput</dataInputRefs>
          <dataInputRefs>_O_TASK_ABANDON_ORDER_productOrderIdInput</dataInputRefs>
          <dataInputRefs>_O_TASK_ABANDON_ORDER_customerIdInput</dataInputRefs>
        </inputSet>
        <outputSet/>
      </ioSpecification>
      <dataInputAssociation><sourceRef>orderId</sourceRef><targetRef>_O_TASK_ABANDON_ORDER_orderIdInput</targetRef></dataInputAssociation>
      <dataInputAssociation><sourceRef>productOrderId</sourceRef><targetRef>_O_TASK_ABANDON_ORDER_productOrderIdInput</targetRef></dataInputAssociation>
      <dataInputAssociation><sourceRef>customerId</sourceRef><targetRef>_O_TASK_ABANDON_ORDER_customerIdInput</targetRef></dataInputAssociation>
    </task>
    <sequenceFlow id="Flow_abandon_end" sourceRef="_O_TASK_ABANDON_ORDER" targetRef="_EVT_AUTO_004"/>
    <endEvent id="_EVT_AUTO_004" name="Erreur Paiement abandonne apres 3 tentatives">
      <incoming>Flow_1mhvniv</incoming>
      <errorEventDefinition errorRef="ERR_BILLING_ACCOUNT" />
    </endEvent>

    <scriptTask id="_B_TASK_INCREMENT_BILLING_RETRY" name="Incrementer retryCount paiement" scriptFormat="http://www.java.com/java">
      <script>java.lang.Integer __rc = (java.lang.Integer) kcontext.getVariable("billingRetryCount"); kcontext.setVariable("billingRetryCount", java.lang.Integer.valueOf((__rc == null ? 0 : __rc.intValue()) + 1));</script>
      <incoming>Flow_1fraxbs</incoming>
      <outgoing>Flow_billing_incr</outgoing>
    </scriptTask>
   
    
    <sequenceFlow id="Flow_billing_incr" sourceRef="_B_TASK_INCREMENT_BILLING_RETRY" targetRef="_B_GW_PAYMENT_MERGE">
  <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java">
    <![CDATA[return paymentRegistered == null || !paymentRegistered;]]>
  </conditionExpression>
</sequenceFlow>

    <!-- ===== SEQUENCE FLOWS (ASSURANCE) ===== -->
    <sequenceFlow id="_sA11" sourceRef="_A_TASK_ESCALATE" targetRef="_A_TASK_RESOLVE_L2" />
    <sequenceFlow id="_sA_ESCALATE" name="Max atteint escalader" sourceRef="_A_GW_MAX_RETRIES" targetRef="_A_TASK_ESCALATE">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java"><![CDATA[return retryCount != null && ((Integer)retryCount) >= 3;]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_sA10b" sourceRef="_A_TASK_INCREMENT_RETRY" targetRef="_A_GW_MAX_RETRIES" />
    <sequenceFlow id="_sA12" sourceRef="_A_TASK_RESOLVE_L2" targetRef="_A_TASK_CLOSE_AFTER_L2" />
    <sequenceFlow id="_sA12b" sourceRef="_A_TASK_CLOSE_AFTER_L2" targetRef="_A_END_RESOLVED_L2" />
    <sequenceFlow id="_sA15" sourceRef="_A_TASK_UPDATE_SERVICE_INV" targetRef="_A_TASK_UPDATE_RESOURCE_INV" />
    <sequenceFlow id="_sA_eSvc2" sourceRef="_A_CT_SERVICE" targetRef="_A_END_ERR_SERVICE" />
    <sequenceFlow id="_sA_eSvc" sourceRef="_A_ERR_SERVICE" targetRef="_A_CT_SERVICE" />
    <sequenceFlow id="_sA14" sourceRef="_A_TASK_VERIFY_SERVICE" targetRef="_A_TASK_UPDATE_SERVICE_INV" />
    <sequenceFlow id="_sA_eNet2" sourceRef="_A_CT_NETWORK" targetRef="_A_END_ERR_NETWORK" />
    <sequenceFlow id="_sA_eNet" sourceRef="_A_ERR_NETWORK" targetRef="_A_CT_NETWORK" />
    <sequenceFlow id="_sA13" sourceRef="_A_TASK_PROVISION_NETWORK" targetRef="_A_TASK_VERIFY_SERVICE" />
    <sequenceFlow id="_sA10" sourceRef="_A_TASK_RESCHEDULE" targetRef="_A_TASK_INCREMENT_RETRY" />
    <sequenceFlow id="_sA_FAILED" name="Echec" sourceRef="_A_GW_INTERVENTION_OK" targetRef="_A_TASK_RESCHEDULE">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java"><![CDATA[return !"SUCCESS".equals(workOrderResult) && !"COMPLETED".equals(workOrderResult);]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_sA_OK" name="Reussie" sourceRef="_A_GW_INTERVENTION_OK" targetRef="_A_TASK_PROVISION_NETWORK">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java"><![CDATA[return "SUCCESS".equals(workOrderResult) || "COMPLETED".equals(workOrderResult);]]></conditionExpression>
    </sequenceFlow>
    
    <!-- FIX (root-cause, 2026-08-05): _sA09 used to go straight from the
         WorkOrderStateChange catch event into the extract/provision/verify/
         update/billing chain, all synchronously on the same thread that
         received the Kafka message. That reentrant chain of 8+ node
         completions is what produces Kogito's "IllegalArgumentException:
         null source" on CreateBillingAccountHandler's completeWorkItem(),
         and — once that's caught defensively — leaves a work item stuck in
         a non-terminal state that the protobuf marshaller then NPEs on
         (setPhaseId(null)) when persisting the instance, rolling back the
         whole transaction even though the real side effects (billing
         account, service provisioning) already happened.
         Rerouted through _A_CHECKPOINT_WORKORDER_COMPLETED below: a near-
         instant timer that forces Kogito to persist a clean checkpoint here
         and resume the rest of the chain via the job-scheduler on its own
         unit of work, outside the original CloudEvent's call stack. -->
    <sequenceFlow id="_sA09" sourceRef="_A_CATCH_WORKORDER_COMPLETED" targetRef="_A_TASK_EXTRACT_WORKORDER_RESULT" />
    <sequenceFlow id="_sA_after_extract" sourceRef="_A_TASK_EXTRACT_WORKORDER_RESULT" targetRef="_A_GW_INTERVENTION_OK" />
    
    
    <sequenceFlow id="_sA08" sourceRef="_A_CATCH_RDV_CONFIRMED" targetRef="_A_CATCH_WORKORDER_COMPLETED" />
    <sequenceFlow id="_sA06" sourceRef="_A_TASK_NOTIFY_RDV" targetRef="_A_THROW_RDV_PROPOSED" />
    <sequenceFlow id="_sA07" sourceRef="_A_THROW_RDV_PROPOSED" targetRef="_A_CATCH_RDV_CONFIRMED" />
    <sequenceFlow id="_sA05" sourceRef="_A_TASK_ASSIGN_TECHNICIAN_DRL" targetRef="_A_TASK_NOTIFY_RDV" />
    <sequenceFlow id="_sA_RETRY" name="Non max reessayer" sourceRef="_A_GW_MAX_RETRIES" targetRef="_A_GW_ASSIGN_MERGE">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java"><![CDATA[return retryCount == null || ((Integer)retryCount) < 3;]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_sA04" sourceRef="_A_TASK_CREATE_WORK_ORDER" targetRef="_A_GW_ASSIGN_MERGE" />
    <sequenceFlow id="_sA_NOT_FEASIBLE" name="Impossible" sourceRef="_A_GW_FEASIBILITY" targetRef="_A_END_NOT_FEASIBLE">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java"><![CDATA[return !"FEASIBLE".equals(feasibilityResult);]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_sA_FEASIBLE" name="Faisable" sourceRef="_A_GW_FEASIBILITY" targetRef="_A_TASK_CREATE_WORK_ORDER">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java"><![CDATA[return "FEASIBLE".equals(feasibilityResult);]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_sA03" sourceRef="_A_TASK_EVALUATE_FEASIBILITY_DRL" targetRef="_A_GW_FEASIBILITY" />
    <sequenceFlow id="_sA02" sourceRef="_A_TASK_GET_NETWORK_CONTEXT" targetRef="_A_TASK_EVALUATE_FEASIBILITY_DRL" />
    <sequenceFlow id="_sA_MERGE" sourceRef="_A_GW_ASSIGN_MERGE" targetRef="_A_TASK_ASSIGN_TECHNICIAN_DRL" />
    <!-- FIX (root-cause, 2026-08-06): fourth checkpoint. The fork here has
         two branches (billing entry via the SO-state-change throw event,
         and the dossier-close tail through the Join). Checkpoint #1 alone
         still left a 6-WorkItemNode unbroken run into the dossier-close
         branch (Extract->Provision->Verify->UpdateServiceInv->
         UpdateResourceInv->Cloturer ProductOrder), long enough to retrigger
         the same Kogito marshalling bug. Yielding right before the fork
         resets the hop count for BOTH branches, so each stays short. -->
    <sequenceFlow id="Flow_A_RES_TO_FORK" sourceRef="_A_TASK_UPDATE_RESOURCE_INV" targetRef="_A_GW_FORK_NOTIFY_CLOSE" />
    <sequenceFlow id="_fork_to_so" sourceRef="_A_GW_FORK_NOTIFY_CLOSE" targetRef="_A_THROW_SO_STATE_CHANGE" />
    <sequenceFlow id="Flow_15jnorx" sourceRef="_A_GW_FORK_NOTIFY_CLOSE" targetRef="_GW_AUTO_002" />

    <!-- ===== SEQUENCE FLOWS (ORDER) ===== -->
    <sequenceFlow id="_sO13" sourceRef="_O_TASK_CLOSE_ORDER" targetRef="_O_END_ACTIVE" />
    <sequenceFlow id="_sO11" sourceRef="_O_THROW_ACTIVATION_NOTIFIED" targetRef="_O_CATCH_DOSSIER_CLOSED" />
    <sequenceFlow id="_sO_SLA" sourceRef="_O_TIMER_SLA" targetRef="_O_CT_SLA" />
    <sequenceFlow id="_sO09" sourceRef="_O_CATCH_SO_STATE_CHANGE" targetRef="_O_CATCH_BILLING_ACTIVATED" />
    <sequenceFlow id="_sO_WAIT_SLA" sourceRef="_O_GW_SLA_WAIT" targetRef="_O_TIMER_SLA" />
    <sequenceFlow id="_sO_WAIT_SO" sourceRef="_O_GW_SLA_WAIT" targetRef="_O_CATCH_SO_STATE_CHANGE" />
    <sequenceFlow id="_sO07" sourceRef="_O_TASK_CREATE_SERVICE_ORDER" targetRef="_O_THROW_ORDER_CREATED" />
    
    
    <sequenceFlow id="_sO_eOrder2" sourceRef="_O_CT_ORDER" targetRef="_O_END_ERR_ORDER" />
    <sequenceFlow id="_sO_eOrder" sourceRef="_O_ERR_ORDER" targetRef="_O_CT_ORDER" />
    <sequenceFlow id="_sO04" sourceRef="_O_TASK_CREATE_PRODUCT_ORDER" targetRef="_O_TASK_CREATE_SERVICE_ORDER" />
    <sequenceFlow id="_sO_INVALID" name="Invalide" sourceRef="_O_GW_ORDER_VALID" targetRef="_O_END_ORDER_INVALID">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java"><![CDATA[return !"VALID".equals(orderValidationResult);]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_sO_VALID" name="Valide" sourceRef="_O_GW_ORDER_VALID" targetRef="_O_TASK_CREATE_PRODUCT_ORDER">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java"><![CDATA[return "VALID".equals(orderValidationResult);]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_sO03" sourceRef="_O_TASK_VALIDATE_ORDER_DRL" targetRef="_O_GW_ORDER_VALID" />
    
    <sequenceFlow id="Flow_1ut2g0j" sourceRef="_O_THROW_ORDER_CREATED" targetRef="_GW_AUTO_001" />
    <sequenceFlow id="Flow_08u2406" sourceRef="_GW_AUTO_001" targetRef="_O_GW_SLA_WAIT" />
    <sequenceFlow id="Flow_182qeom" sourceRef="_GW_AUTO_001" targetRef="_A_TASK_GET_NETWORK_CONTEXT" />
    <sequenceFlow id="Flow_1r50ub5" sourceRef="_O_CATCH_BILLING_ACTIVATED" targetRef="_O_THROW_ACTIVATION_NOTIFIED" />
    <sequenceFlow id="Flow_02gck73" sourceRef="_GW_AUTO_002" targetRef="_O_TASK_CLOSE_ORDER" />
    <sequenceFlow id="Flow_1eyfs3h" sourceRef="_O_CATCH_DOSSIER_CLOSED" targetRef="_GW_AUTO_002" />

    <!-- ===== SEQUENCE FLOWS (QUOTE) ===== -->
    <sequenceFlow id="_sQ04" sourceRef="_Q_TASK_CREATE_QUOTE" targetRef="_Q_THROW_QUOTE_PROPOSED" />
    <sequenceFlow id="_sQ_INVALID" name="Offre invalide" sourceRef="_Q_GW_OFFER_VALID" targetRef="_Q_END_OFFER_REJECTED">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java"><![CDATA[return !"VALID".equals(offerValidationResult);]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_sQ_VALID" name="Offre valide" sourceRef="_Q_GW_OFFER_VALID" targetRef="_Q_TASK_CREATE_QUOTE">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java"><![CDATA[return "VALID".equals(offerValidationResult);]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_sQ03" sourceRef="_Q_TASK_VALIDATE_OFFER_DRL" targetRef="_Q_GW_OFFER_VALID" />
    <sequenceFlow id="_sQ_NOT_ELIGIBLE" name="Non eligible" sourceRef="_Q_GW_ELIGIBLE" targetRef="_Q_END_NOT_ELIGIBLE">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java"><![CDATA[return !"ELIGIBLE".equals(eligibilityResult);]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_sQ_ELIGIBLE" name="Eligible" sourceRef="_Q_GW_ELIGIBLE" targetRef="_Q_TASK_VALIDATE_OFFER_DRL">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java"><![CDATA[return "ELIGIBLE".equals(eligibilityResult);]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_sQ02" sourceRef="_Q_TASK_LOAD_ELIGIBILITY" targetRef="_Q_GW_ELIGIBLE" />
    <sequenceFlow id="_sQ01" sourceRef="_START_ORDER_SUBMITTED" targetRef="_Q_TASK_LOAD_ELIGIBILITY" />
    <sequenceFlow id="Flow_Q_UPD_TO_FORK" sourceRef="_Q_TASK_UPDATE_QUOTE_ACCEPTED" targetRef="_Q_GW_FORK_AFTER_ACCEPT" />
    <sequenceFlow id="Flow_1rhg4uw" sourceRef="_Q_GW_FORK_AFTER_ACCEPT" targetRef="_O_TASK_VALIDATE_ORDER_DRL" />
    <sequenceFlow id="Flow_0m15qrp" sourceRef="_Q_GW_FORK_AFTER_ACCEPT" targetRef="_C_CATCH_RDV" />
    <sequenceFlow id="Flow_14tqr16" sourceRef="_Q_THROW_QUOTE_PROPOSED" targetRef="_TASK_AUTO_001" />

    <!-- ===== SEQUENCE FLOWS (CLIENT) ===== -->
    <sequenceFlow id="_sC06" sourceRef="_C_TASK_VERIFY_SATISFACTION" targetRef="_C_THROW_DOSSIER_CLOSED" />
    <sequenceFlow id="_sC05" sourceRef="_C_CATCH_ACTIVATION" targetRef="_C_TASK_VERIFY_SATISFACTION" />
    <sequenceFlow id="_sC04" sourceRef="_C_THROW_RDV_CONFIRMED" targetRef="_C_CATCH_ACTIVATION" />
    <sequenceFlow id="_sC03" sourceRef="_C_CATCH_RDV" targetRef="_C_SCRIPT_PARSE_RDV" />
    <sequenceFlow id="Flow_rdv_parsed" sourceRef="_C_SCRIPT_PARSE_RDV" targetRef="_C_CATCH_RDV_CONFIRMED_WAIT" />
    <sequenceFlow id="Flow_rdv_wait_ok" sourceRef="_C_CATCH_RDV_CONFIRMED_WAIT" targetRef="_C_THROW_RDV_CONFIRMED" />
    <sequenceFlow id="_sC02" sourceRef="_C_THROW_QUOTE_ACCEPTED" targetRef="_Q_TASK_UPDATE_QUOTE_ACCEPTED" />
    <sequenceFlow id="_sC_NON" name="Refuse" sourceRef="_C_GW_QUOTE_DECISION" targetRef="_C_THROW_QUOTE_REJECTED">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java"><![CDATA[return !"ACCEPTED".equals(quoteDecision);]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_sC_OUI" name="Accepte" sourceRef="_C_GW_QUOTE_DECISION" targetRef="_C_THROW_QUOTE_ACCEPTED">
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java"><![CDATA[return "ACCEPTED".equals(quoteDecision);]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_1beu1ke" sourceRef="_TASK_AUTO_001" targetRef="_Q_TASK_BUILD_ACCEPTED_PAYLOAD" />
    <sequenceFlow id="Flow_after_build" sourceRef="_Q_TASK_BUILD_ACCEPTED_PAYLOAD" targetRef="_C_GW_QUOTE_DECISION" />
    <sequenceFlow id="Flow_1n372qm" sourceRef="_C_THROW_QUOTE_REJECTED" targetRef="_C_END_QUOTE_REJECTED" />
    <sequenceFlow id="Flow_C_DOSSIER_TO_END" sourceRef="_C_THROW_DOSSIER_CLOSED" targetRef="_C_END_DOSSIER_CLOSED" />

    <!-- ===== INTERMEDIATE EVENTS (CLIENT) ===== -->
    <intermediateThrowEvent id="_C_THROW_DOSSIER_CLOSED" name="Publier DossierClosed">
