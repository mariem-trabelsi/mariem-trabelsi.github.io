    <sourceRef>_B_TASK_APPLY_OFFER_PRICING_DRL_billingAccountIdOutput</sourceRef>
    <targetRef>billingAccountId</targetRef>
  </dataOutputAssociation>
  <dataOutputAssociation>
    <sourceRef>_B_TASK_APPLY_OFFER_PRICING_DRL_confirmedMonthlyPriceOutput</sourceRef>
