        <flowNodeRef>_GW_AUTO_003</flowNodeRef>
        <flowNodeRef>_B_TASK_CANCEL_INVOICE</flowNodeRef>
        <flowNodeRef>_EVT_AUTO_004</flowNodeRef>
      <flowNodeRef>_B_END_ERR_ACTIVATE</flowNodeRef><flowNodeRef>_B_CT_ACTIVATE</flowNodeRef><flowNodeRef>_B_COMP_INVOICE</flowNodeRef></lane>
      <lane id="_L_ASSURANCE" name="Provisioning &amp; Field Service TMF641 697 638 639">
        <flowNodeRef>_A_COMP_WORKORDER</flowNodeRef>
        <flowNodeRef>_A_TASK_CANCEL_WORK_ORDER</flowNodeRef>
        <flowNodeRef>_A_COMP_NETWORK</flowNodeRef>
        <flowNodeRef>_A_TASK_RESTORE_NETWORK</flowNodeRef>
        <flowNodeRef>_A_TASK_INCREMENT_RETRY</flowNodeRef>
        
        <flowNodeRef>_A_TASK_RESOLVE_L2</flowNodeRef>
        <flowNodeRef>_A_TASK_CLOSE_AFTER_L2</flowNodeRef>
        <flowNodeRef>_A_TASK_ESCALATE</flowNodeRef>
        <flowNodeRef>_A_GW_MAX_RETRIES</flowNodeRef>
        <flowNodeRef>_A_END_RESOLVED_L2</flowNodeRef>
        <flowNodeRef>_A_THROW_SO_STATE_CHANGE</flowNodeRef>
        <flowNodeRef>_A_TASK_UPDATE_RESOURCE_INV</flowNodeRef>
        <flowNodeRef>_A_GW_FORK_NOTIFY_CLOSE</flowNodeRef>
        <flowNodeRef>_A_TASK_UPDATE_SERVICE_INV</flowNodeRef>
        <flowNodeRef>_A_END_ERR_SERVICE</flowNodeRef>
        <flowNodeRef>_A_CT_SERVICE</flowNodeRef>
        <flowNodeRef>_A_TASK_VERIFY_SERVICE</flowNodeRef>
        <flowNodeRef>_A_END_ERR_NETWORK</flowNodeRef>
        <flowNodeRef>_A_CT_NETWORK</flowNodeRef>
        <flowNodeRef>_A_TASK_PROVISION_NETWORK</flowNodeRef>
        <flowNodeRef>_A_TASK_RESCHEDULE</flowNodeRef>
        <flowNodeRef>_A_GW_INTERVENTION_OK</flowNodeRef>
        <flowNodeRef>_A_CATCH_WORKORDER_COMPLETED</flowNodeRef>
        
        <flowNodeRef>_A_CATCH_RDV_CONFIRMED</flowNodeRef>
        <flowNodeRef>_A_THROW_RDV_PROPOSED</flowNodeRef>
        <flowNodeRef>_A_TASK_NOTIFY_RDV</flowNodeRef>
        
        <flowNodeRef>_A_TASK_ASSIGN_TECHNICIAN_DRL</flowNodeRef>
        
        <flowNodeRef>_A_TASK_CREATE_WORK_ORDER</flowNodeRef>
        <flowNodeRef>_A_END_NOT_FEASIBLE</flowNodeRef>
        <flowNodeRef>_A_GW_FEASIBILITY</flowNodeRef>
        <flowNodeRef>_A_TASK_EVALUATE_FEASIBILITY_DRL</flowNodeRef>
        
        <flowNodeRef>_A_TASK_GET_NETWORK_CONTEXT</flowNodeRef>
        <flowNodeRef>_A_ERR_SERVICE</flowNodeRef>
        
        
        
        <flowNodeRef>_A_ERR_NETWORK</flowNodeRef>
        
        <flowNodeRef>_A_GW_ASSIGN_MERGE</flowNodeRef>
        <flowNodeRef>_A_TASK_EXTRACT_WORKORDER_RESULT</flowNodeRef>
      <flowNodeRef>_A_TASK_RELEASE_RESERVED_PORT</flowNodeRef><flowNodeRef>_A_COMP_RESERVATION</flowNodeRef></lane>
      <lane id="_L_ORDER" name="Order Management Service TMF622 641">
        <flowNodeRef>_O_COMP_ORDER</flowNodeRef>
        <flowNodeRef>_O_TASK_CANCEL_PRODUCT_ORDER</flowNodeRef>
        <flowNodeRef>_O_END_ACTIVE</flowNodeRef>
        <flowNodeRef>_O_TASK_CLOSE_ORDER</flowNodeRef>
        <flowNodeRef>_O_CATCH_DOSSIER_CLOSED</flowNodeRef>
        <flowNodeRef>_O_THROW_ACTIVATION_NOTIFIED</flowNodeRef>
        <flowNodeRef>_O_CATCH_BILLING_ACTIVATED</flowNodeRef>
        <flowNodeRef>_O_END_SLA_BREACH</flowNodeRef>
        <flowNodeRef>_O_TIMER_SLA</flowNodeRef>
        <flowNodeRef>_O_CATCH_SO_STATE_CHANGE</flowNodeRef>
        <flowNodeRef>_O_GW_SLA_WAIT</flowNodeRef>
        <flowNodeRef>_O_THROW_ORDER_CREATED</flowNodeRef>
        <flowNodeRef>_O_TASK_CREATE_SERVICE_ORDER</flowNodeRef>
        
        
        <flowNodeRef>_O_END_ERR_ORDER</flowNodeRef>
        <flowNodeRef>_O_CT_ORDER</flowNodeRef>
        <flowNodeRef>_O_TASK_CREATE_PRODUCT_ORDER</flowNodeRef>
        <flowNodeRef>_O_END_ORDER_INVALID</flowNodeRef>
        <flowNodeRef>_O_GW_ORDER_VALID</flowNodeRef>
        <flowNodeRef>_O_TASK_VALIDATE_ORDER_DRL</flowNodeRef>
        
        <flowNodeRef>_O_ERR_ORDER</flowNodeRef>
        <flowNodeRef>_GW_AUTO_001</flowNodeRef>
        <flowNodeRef>_GW_AUTO_002</flowNodeRef>
      <flowNodeRef>_O_TASK_ABANDON_ORDER</flowNodeRef><flowNodeRef>_O_CT_SLA</flowNodeRef></lane>
      <lane id="_L_QUOTE" name="Commercial Service">
        <flowNodeRef>_Q_THROW_QUOTE_PROPOSED</flowNodeRef>
        
        <flowNodeRef>_Q_END_OFFER_REJECTED</flowNodeRef>
        <flowNodeRef>_Q_GW_OFFER_VALID</flowNodeRef>
        <flowNodeRef>_Q_TASK_VALIDATE_OFFER_DRL</flowNodeRef>
