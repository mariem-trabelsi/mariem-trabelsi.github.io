      <dataOutputRefs>_B_TASK_APPLY_OFFER_PRICING_DRL_offerIdOutput</dataOutputRefs>
      <!-- NEW: include this in the output set -->
      <dataOutputRefs>_B_TASK_APPLY_OFFER_PRICING_DRL_pricingAppliedOutput</dataOutputRefs>
    </outputSet>
  </ioSpecification>
  <!-- Existing dataInputAssociations -->
