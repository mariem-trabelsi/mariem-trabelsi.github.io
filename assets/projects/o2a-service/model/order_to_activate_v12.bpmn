  <itemDefinition id="_serviceIdItem" structureRef="java.lang.String" />
  <itemDefinition id="_resourceIdItem" structureRef="java.lang.String" />
  <itemDefinition id="_workOrderResultPayloadItem" structureRef="java.lang.String" />
  <itemDefinition id="_quoteAcceptedPayloadItem" structureRef="java.lang.String" />
  <itemDefinition id="_quoteRejectedPayloadItem" structureRef="java.lang.String" />
