      <messageEventDefinition messageRef="_msg_RdvConfirmedPub" />
    </intermediateThrowEvent>

    <intermediateCatchEvent id="_C_CATCH_RDV" name="Recevoir proposition de RDV email SMS espace client">
      <incoming>Flow_0m15qrp</incoming>
      <outgoing>_sC03</outgoing>
      <ioSpecification>
        <dataOutput id="_C_CATCH_RDV_msgOutput" name="Message" itemSubjectRef="_msgItem_RdvProposed" />
        <outputSet><dataOutputRefs>_C_CATCH_RDV_msgOutput</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation><sourceRef>_C_CATCH_RDV_msgOutput</sourceRef><targetRef>rdvProposedPayload</targetRef></dataOutputAssociation>
      <signalEventDefinition signalRef="_sig_RdvProposed" />
    </intermediateCatchEvent>

    <scriptTask id="_C_SCRIPT_PARSE_RDV" name="Extraire appointmentId depuis RdvProposed" scriptFormat="http://www.java.com/java">
      <script><![CDATA[
        String raw = (String) kcontext.getVariable("rdvProposedPayload");
        if (raw != null && raw.trim().startsWith("{")) {
            try {
                com.fasterxml.jackson.databind.ObjectMapper om = new com.fasterxml.jackson.databind.ObjectMapper();
                java.util.Map data = om.readValue(raw, java.util.Map.class);
                Object apptId = data.get("appointmentId");
                if (apptId != null) {
                    kcontext.setVariable("appointmentId", String.valueOf(apptId));
                }
            } catch (Exception e) {}
        }
      ]]></script>
      <incoming>_sC03</incoming>
      <outgoing>Flow_rdv_parsed</outgoing>
    </scriptTask>

    <intermediateCatchEvent id="_C_CATCH_RDV_CONFIRMED_WAIT" name="Attendre confirmation reelle du client avant echo notification">
      <incoming>Flow_rdv_parsed</incoming>
      <outgoing>Flow_rdv_wait_ok</outgoing>
      <ioSpecification>
        <dataOutput id="_C_CATCH_RDV_CONFIRMED_WAIT_msgOutput" name="Message" itemSubjectRef="_msgItem_RdvConfirmed" />
        <outputSet><dataOutputRefs>_C_CATCH_RDV_CONFIRMED_WAIT_msgOutput</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation><sourceRef>_C_CATCH_RDV_CONFIRMED_WAIT_msgOutput</sourceRef><targetRef>rdvConfirmedPayload</targetRef></dataOutputAssociation>
      <messageEventDefinition messageRef="_msg_RdvConfirmed" />
    </intermediateCatchEvent>

