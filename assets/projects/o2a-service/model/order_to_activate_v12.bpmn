</task>

    <task id="_B_TASK_CREATE_BILLING_ACCOUNT" name="Creer le compte de facturation TMF666 Kill Bill" drools:taskName="BillingAccountService_createAccount">
      <incoming>_sA_to_Billing</incoming>
      <outgoing>_sB02</outgoing>
      <ioSpecification>
        <dataInput id="_B_TASK_CREATE_BILLING_ACCOUNT_orderIdInput" name="orderId" itemSubjectRef="_orderIdItem"/>
