    <!--
      Activation de l'abonnement : elle appelle Kill Bill, donc elle peut
      echouer pour une raison d'infrastructure. Elle n'avait AUCUNE bordure
      d'erreur, alors que ses deux voisines immediates en ont une.

      Observe en coupant l'adaptateur : le work item
      `BillingAccountService_activateSubscription` passe en erreur, l'exception
      n'a nulle part ou aller, et l'instance reste ACTIVE sans etre marquee en
      erreur — ni compensation, ni trace, ni reprise par l'API de gestion. Le
      moteur n'y est pour rien : c'est le modele qui etait incomplet.

      Chemin propre a cette bordure : un evenement intermediaire n'accepte
      qu'UN seul entrant, on ne peut donc pas se brancher sur la compensation
      de la facture. Meme forme, meme portee compensee.
    -->
    <boundaryEvent id="_B_ERR_ACTIVATE_BILLING" name="Echec activation abonnement" attachedToRef="_B_TASK_ACTIVATE_BILLING">
      <outgoing>_sB_eAct</outgoing>
      <errorEventDefinition errorRef="ERR_SUBSCRIPTION" />
    </boundaryEvent>

    <intermediateThrowEvent id="_B_CT_ACTIVATE" name="Compensation activation">
      <incoming>_sB_eAct</incoming>
      <outgoing>_sB_eAct2</outgoing>
      <compensateEventDefinition />
    </intermediateThrowEvent>

    <endEvent id="_B_END_ERR_ACTIVATE" name="Erreur Abonnement non active a retraiter">
      <incoming>_sB_eAct2</incoming>
      <errorEventDefinition errorRef="ERR_BILLING" />
    </endEvent>

    <sequenceFlow id="_sB_eAct"  sourceRef="_B_ERR_ACTIVATE_BILLING" targetRef="_B_CT_ACTIVATE" />
    <sequenceFlow id="_sB_eAct2" sourceRef="_B_CT_ACTIVATE" targetRef="_B_END_ERR_ACTIVATE" />

    <boundaryEvent id="_B_ERR_INVOICE" name="Echec envoi facture" attachedToRef="_B_TASK_SEND_FIRST_INVOICE">
      <outgoing>_sB_eInv</outgoing>
      <errorEventDefinition errorRef="ERR_BILLING" />
    </boundaryEvent>

    <!-- ===== SCRIPT TASKS ===== -->
    <scriptTask id="_A_TASK_INCREMENT_RETRY" name="Incrementer retryCount" scriptFormat="http://www.java.com/java">
      <script><![CDATA[
        java.lang.Integer __rc = (java.lang.Integer) kcontext.getVariable("retryCount");
        kcontext.setVariable("retryCount", java.lang.Integer.valueOf((__rc == null ? 0 : __rc.intValue()) + 1));

        // Une nouvelle tentative repart sans rendez-vous.
        //
        // NotifyRdvHandler ne reserve un creneau que si `appointmentId` est
        // vide — garde d'idempotence, pour ne pas double-reserver quand la
        // tache est rejouee. Mais sur une REPLANIFICATION cette meme garde
        // empechait toute nouvelle proposition : le rendez-vous de la
        // tentative precedente etait deja `confirmed`, le client n'etait
        // jamais resollicite, et le processus attendait un RdvConfirme qui ne
        // pouvait plus venir. La boucle de reprise etait donc sans issue des
        // la deuxieme tentative.
        kcontext.setVariable("appointmentId", null);
        kcontext.setVariable("rdvSlot", null);
      ]]></script>
      <incoming>_sA10</incoming>
      <outgoing>_sA10b</outgoing>
    </scriptTask>

    <userTask id="_A_TASK_RESOLVE_L2" name="Resoudre l incident Support L2 NOC" drools:taskName="ResolveL2" drools:groupId="support-l2">
      <incoming>_sA11</incoming>
      <outgoing>_sA12</outgoing>
      <ioSpecification>
        <dataInput id="_A_TASK_RESOLVE_L2_TaskNameInput" name="TaskName" itemSubjectRef="_taskNameItem" />
        <inputSet><dataInputRefs>_A_TASK_RESOLVE_L2_TaskNameInput</dataInputRefs></inputSet>
        <outputSet />
      </ioSpecification>
      <dataInputAssociation>
        <targetRef>_A_TASK_RESOLVE_L2_TaskNameInput</targetRef>
        <assignment>
          <from xsi:type="tFormalExpression">ResolveL2</from>
          <to xsi:type="tFormalExpression">_A_TASK_RESOLVE_L2_TaskNameInput</to>
        </assignment>
      </dataInputAssociation>
    </userTask>

    <task id="_A_TASK_ESCALATE" name="Ouvrir un TroubleTicket TMF621 Trouble Management" drools:taskName="TroubleTicketService_createTroubleTicket">
      <incoming>_sA_ESCALATE</incoming>
      <outgoing>_sA11</outgoing>
      <ioSpecification>
        <dataInput id="_A_TASK_ESCALATE_orderIdInput" name="orderId" itemSubjectRef="_orderIdItem" />
        <dataInput id="_A_TASK_ESCALATE_workOrderIdInput" name="workOrderId" itemSubjectRef="_workOrderIdItem" />
        <dataInput id="_A_TASK_ESCALATE_technicianIdInput" name="technicianId" itemSubjectRef="_technicianIdItem" />
        <dataInput id="_A_TASK_ESCALATE_retryCountInput" name="retryCount" itemSubjectRef="_retryCountItem" />
        <dataOutput id="_A_TASK_ESCALATE_ticketOutput" name="troubleTicketId" itemSubjectRef="_troubleTicketIdItem" />
        <inputSet>
          <dataInputRefs>_A_TASK_ESCALATE_orderIdInput</dataInputRefs>
          <dataInputRefs>_A_TASK_ESCALATE_workOrderIdInput</dataInputRefs>
          <dataInputRefs>_A_TASK_ESCALATE_technicianIdInput</dataInputRefs>
          <dataInputRefs>_A_TASK_ESCALATE_retryCountInput</dataInputRefs>
        </inputSet>
        <outputSet><dataOutputRefs>_A_TASK_ESCALATE_ticketOutput</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataInputAssociation><sourceRef>orderId</sourceRef><targetRef>_A_TASK_ESCALATE_orderIdInput</targetRef></dataInputAssociation>
      <dataInputAssociation><sourceRef>workOrderId</sourceRef><targetRef>_A_TASK_ESCALATE_workOrderIdInput</targetRef></dataInputAssociation>
      <dataInputAssociation><sourceRef>technicianId</sourceRef><targetRef>_A_TASK_ESCALATE_technicianIdInput</targetRef></dataInputAssociation>
      <dataInputAssociation><sourceRef>retryCount</sourceRef><targetRef>_A_TASK_ESCALATE_retryCountInput</targetRef></dataInputAssociation>
      <dataOutputAssociation><sourceRef>_A_TASK_ESCALATE_ticketOutput</sourceRef><targetRef>troubleTicketId</targetRef></dataOutputAssociation>
    </task>

    <exclusiveGateway id="_A_GW_MAX_RETRIES" name="Nombre max de tentatives atteint" gatewayDirection="Diverging">
      <incoming>_sA10b</incoming>
      <outgoing>_sA_RETRY</outgoing>
      <outgoing>_sA_ESCALATE</outgoing>
    </exclusiveGateway>

    <!-- La fin _A_END_RESOLVED_L2 est TERMINANTE : plus rien ne s'execute
         derriere elle. Sans cette tache, la commande abandonnee gardait son
         port, laissait son incident ouvert et bloquait son client a vie. -->
    <task id="_A_TASK_CLOSE_AFTER_L2" name="Cloturer le dossier apres passage L2" drools:taskName="TroubleTicketService_closeAfterL2">
      <incoming>_sA12</incoming>
      <outgoing>_sA12b</outgoing>
      <ioSpecification>
        <dataInput id="_A_TASK_CLOSE_L2_orderIdInput" name="orderId" itemSubjectRef="_orderIdItem" />
        <dataInput id="_A_TASK_CLOSE_L2_customerIdInput" name="customerId" itemSubjectRef="_customerIdItem" />
        <dataInput id="_A_TASK_CLOSE_L2_productOrderIdInput" name="productOrderId" itemSubjectRef="_productOrderIdItem" />
        <dataInput id="_A_TASK_CLOSE_L2_resourceIdInput" name="resourceId" itemSubjectRef="_resourceIdItem" />
        <dataInput id="_A_TASK_CLOSE_L2_ticketIdInput" name="troubleTicketId" itemSubjectRef="_troubleTicketIdItem" />
        <dataOutput id="_A_TASK_CLOSE_L2_orderIdOutput" name="orderId" itemSubjectRef="_orderIdItem" />
        <inputSet>
          <dataInputRefs>_A_TASK_CLOSE_L2_orderIdInput</dataInputRefs>
          <dataInputRefs>_A_TASK_CLOSE_L2_customerIdInput</dataInputRefs>
          <dataInputRefs>_A_TASK_CLOSE_L2_productOrderIdInput</dataInputRefs>
          <dataInputRefs>_A_TASK_CLOSE_L2_resourceIdInput</dataInputRefs>
          <dataInputRefs>_A_TASK_CLOSE_L2_ticketIdInput</dataInputRefs>
        </inputSet>
        <outputSet><dataOutputRefs>_A_TASK_CLOSE_L2_orderIdOutput</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataInputAssociation><sourceRef>orderId</sourceRef><targetRef>_A_TASK_CLOSE_L2_orderIdInput</targetRef></dataInputAssociation>
      <dataInputAssociation><sourceRef>customerId</sourceRef><targetRef>_A_TASK_CLOSE_L2_customerIdInput</targetRef></dataInputAssociation>
      <dataInputAssociation><sourceRef>productOrderId</sourceRef><targetRef>_A_TASK_CLOSE_L2_productOrderIdInput</targetRef></dataInputAssociation>
      <dataInputAssociation><sourceRef>resourceId</sourceRef><targetRef>_A_TASK_CLOSE_L2_resourceIdInput</targetRef></dataInputAssociation>
      <dataInputAssociation><sourceRef>troubleTicketId</sourceRef><targetRef>_A_TASK_CLOSE_L2_ticketIdInput</targetRef></dataInputAssociation>
      <dataOutputAssociation><sourceRef>_A_TASK_CLOSE_L2_orderIdOutput</sourceRef><targetRef>orderId</targetRef></dataOutputAssociation>
    </task>

    <endEvent id="_A_END_RESOLVED_L2" name="Fin Incident resolu par L2 commande a retraiter manuellement">
      <incoming>_sA12b</incoming>
      <terminateEventDefinition />
    </endEvent>

    <!-- ===== BILLING TASKS ===== -->
    <endEvent id="_B_END_BILLING_DONE" name="Fin Facturation activee premiere facture envoyee">
      <incoming>Flow_0h2pqbd</incoming>
    </endEvent>

