 <task id="_B_TASK_APPLY_OFFER_PRICING_DRL" drools:taskName="ApplyOfferPricingDrlHandler" name="Appliquer la tarification de l offre DRL groupe billing pricing">
  <incoming>_sB03</incoming>
  <outgoing>_sB04</outgoing>
  <ioSpecification>
    <dataInput id="_B_TASK_APPLY_OFFER_PRICING_DRL_orderIdInput" name="orderId" itemSubjectRef="_orderIdItem" />
