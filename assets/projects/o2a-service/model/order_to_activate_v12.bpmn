  <itemDefinition id="_troubleTicketIdItem" structureRef="java.lang.String" />
  <!-- slaDueDate est une date calendaire transportee telle quelle ("2026-08-12").
       Declaree java.util.Date, Kogito tentait de la parser au format
       "yyyy-MM-dd HH:mm:ss.SSS" a l'ecriture de la sortie de
       _O_TASK_VALIDATE_ORDER_DRL : ParseException, work item en echec, et
       TOUTE commande acceptee restait bloquee a la validation. Le seul
       consommateur, CreateServiceOrderHandler, la lit en getStringParam. -->
    <itemDefinition id="_slaDueDateItem" structureRef="java.lang.String" />
  <itemDefinition id="_slaDurationItem" structureRef="java.lang.String" />
  <itemDefinition id="_technicianIdItem" structureRef="java.lang.String" />
  <itemDefinition id="_workOrderIdItem" structureRef="java.lang.String" />
  <itemDefinition id="_workOrderResultItem" structureRef="java.lang.String" />
  <itemDefinition id="_appointmentIdItem" structureRef="java.lang.String" />
