        <flowNodeRef>_B_END_ERR_INVOICE</flowNodeRef>
        <flowNodeRef>_B_CT_INVOICE</flowNodeRef>
        <flowNodeRef>_B_TASK_SEND_FIRST_INVOICE</flowNodeRef>
        <flowNodeRef>_B_TASK_ACTIVATE_BILLING</flowNodeRef>
        <flowNodeRef>_B_THROW_BILLING_ACTIVATED</flowNodeRef>
        <flowNodeRef>_B_TASK_CREATE_BILLING_ACCOUNT</flowNodeRef>
        <flowNodeRef>_B_ERR_INVOICE</flowNodeRef>
        <flowNodeRef>_B_GW_PAYMENT_MERGE</flowNodeRef>
        
        
        <flowNodeRef>_B_TASK_REGISTER_PAYMENT</flowNodeRef>
