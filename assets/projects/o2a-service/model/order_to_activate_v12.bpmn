  </dataInputAssociation>
  <dataInputAssociation>
    <sourceRef>offerId</sourceRef>
    <targetRef>_B_TASK_APPLY_OFFER_PRICING_DRL_offerIdInput</targetRef>
  </dataInputAssociation>
  <dataInputAssociation>
    <sourceRef>billingAccountId</sourceRef>
    <targetRef>_B_TASK_APPLY_OFFER_PRICING_DRL_billingAccountIdInput</targetRef>
  </dataInputAssociation>
  <!-- Existing dataOutputAssociations -->
