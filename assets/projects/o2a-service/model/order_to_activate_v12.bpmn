    <!-- ===== SCRIPT TASK FOR EXTRACTING WORKORDER RESULT ===== -->
    <scriptTask id="_A_TASK_EXTRACT_WORKORDER_RESULT" name="Extraire workOrderResult" scriptFormat="http://www.java.com/java">
      <script><![CDATA[
        String raw = (String) kcontext.getVariable("workOrderResultPayload");
        if (raw != null && !raw.trim().isEmpty()) {
            String trimmed = raw.trim();
            if (trimmed.startsWith("{") && trimmed.endsWith("}")) {
                try {
                    com.fasterxml.jackson.databind.ObjectMapper om = new com.fasterxml.jackson.databind.ObjectMapper();
                    java.util.Map data = om.readValue(trimmed, java.util.Map.class);
                    Object result = data.get("workOrderResult");
                    if (result == null) result = data.get("interventionResult");
                    if (result == null) {
                        Object etat = data.get("state");
                        if (etat != null) {
                            String e = String.valueOf(etat);
                            if ("completed".equalsIgnoreCase(e)) result = "SUCCESS";
                            else if ("failed".equalsIgnoreCase(e) || "cancelled".equalsIgnoreCase(e)) result = "FAILED";
                        }
                    }
                    // Ne JAMAIS presumer le succes : la cle attendue avait
                    // change de nom, le script ne trouvait plus rien et posait
                    // SUCCESS — une intervention echouee etait annoncee au
                    // client comme reussie, et la branche de replanification
                    // etait inatteignable. Dans le doute, c'est un echec.
                    kcontext.setVariable("workOrderResult",
                        result != null ? String.valueOf(result).toUpperCase() : "FAILED");
                } catch (Exception e) {
                    kcontext.setVariable("workOrderResult", trimmed);
                }
            } else {
                kcontext.setVariable("workOrderResult", trimmed);
            }
        } else {
            kcontext.setVariable("workOrderResult", "FAILED");
        }
      ]]></script>
      <incoming>_sA09</incoming>
      <outgoing>_sA_after_extract</outgoing>
    </scriptTask>

    <!-- ===== INTERMEDIATE EVENTS (ASSURANCE continued) ===== -->
    <intermediateCatchEvent id="_A_CATCH_WORKORDER_COMPLETED" name="Recevoir WorkOrderStateChange Kafka completed ou failed">
      
