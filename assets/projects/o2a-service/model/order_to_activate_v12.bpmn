      <dataOutputAssociation><sourceRef>_B_TASK_CREATE_BILLING_ACCOUNT_billingAccountIdOutput</sourceRef><targetRef>billingAccountId</targetRef></dataOutputAssociation>
    </task>

    <intermediateThrowEvent id="_B_THROW_BILLING_ACTIVATED" name="Publier BillingActivated Kafka topic billing activated">
      <extensionElements><drools:metaData name="customScope"><drools:metaValue>processInstance</drools:metaValue></drools:metaData></extensionElements>
      <incoming>_sB06</incoming>
      <outgoing>Flow_0h2pqbd</outgoing>
      <ioSpecification>
        <dataInput id="_B_THROW_BILLING_ACTIVATED_msgInput" name="Message" itemSubjectRef="_msgItem_BillingActivated" />
        <inputSet><dataInputRefs>_B_THROW_BILLING_ACTIVATED_msgInput</dataInputRefs></inputSet>
      </ioSpecification>
      <dataInputAssociation><sourceRef>billingActivatedPayload</sourceRef><targetRef>_B_THROW_BILLING_ACTIVATED_msgInput</targetRef></dataInputAssociation>
      <signalEventDefinition signalRef="_signal_BillingActivatedInternal" />
    </intermediateThrowEvent>

    <endEvent id="_B_END_ERR_PRICING" name="Erreur Tarification non appliquee">
      <incoming>_sB_ePrice2</incoming>
      <errorEventDefinition errorRef="ERR_BILLING" />
    </endEvent>

    <intermediateThrowEvent id="_B_CT_PRICING" name="Compensation tarification">
      <incoming>_sB_ePrice</incoming>
      <outgoing>_sB_ePrice2</outgoing>
      <compensateEventDefinition />
    </intermediateThrowEvent>

    <!-- ===== CLIENT TASKS ===== -->
    <startEvent id="_START_ORDER_SUBMITTED" name="Commande soumise via API site web agent">
      <outgoing>_sQ01</outgoing>
      <ioSpecification>
        <dataOutput id="_START_ORDER_SUBMITTED_msgOutput" name="Message" itemSubjectRef="_msgItem_OrderSubmitted" />
        <outputSet><dataOutputRefs>_START_ORDER_SUBMITTED_msgOutput</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation><sourceRef>_START_ORDER_SUBMITTED_msgOutput</sourceRef><targetRef>orderSubmittedPayload</targetRef></dataOutputAssociation>
      <messageEventDefinition messageRef="_msg_OrderSubmitted" />
    </startEvent>

    <boundaryEvent id="_EVT_AUTO_001" name="Timer expiration devis 48h" attachedToRef="_TASK_AUTO_001">
      <outgoing>Flow_1xuzymf</outgoing>
      <timerEventDefinition><timeDuration xsi:type="tFormalExpression">PT3M</timeDuration></timerEventDefinition>
