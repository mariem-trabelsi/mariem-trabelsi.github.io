<itemDefinition id="_pricingAppliedItem" structureRef="java.lang.Boolean" />

  <!-- ===== MESSAGES ===== -->
  <message id="_msg_BillingActivatedPub" name="BillingActivatedPub" itemRef="_msgItem_BillingActivatedPub" />
  <message id="_msg_DossierClosedPub" name="DossierClosedPub" itemRef="_msgItem_DossierClosedPub" />
  <message id="_msg_RdvConfirmedPub" name="RdvConfirmedPub" itemRef="_msgItem_RdvConfirmedPub" />

  <message id="_msg_BillingTriggerSub" name="BillingTriggerSub" itemRef="_msgItem_BillingTriggerSub" />

  <message id="_msg_RdvProposedSub" name="RdvProposedSub" itemRef="_msgItem_RdvProposedSub" />
  <message id="_msg_OrderSubmitted" name="OrderSubmitted" itemRef="_msgItem_OrderSubmitted" />
  <message id="_msg_QuoteProposed" name="QuoteProposed" itemRef="_msgItem_QuoteProposed" />
  <message id="_msg_QuoteAccepted" name="QuoteAccepted" itemRef="_msgItem_QuoteAccepted" />
  <message id="_msg_QuoteRejected" name="QuoteRejected" itemRef="_msgItem_QuoteRejected" />
  <message id="_msg_OrderCreated" name="OrderCreated" itemRef="_msgItem_OrderCreated" />
  <message id="_msg_RdvProposed" name="RdvProposed" itemRef="_msgItem_RdvProposed" />
  <message id="_msg_RdvConfirmed" name="RdvConfirmed" itemRef="_msgItem_RdvConfirmed" />
  <message id="_msg_ServiceOrderStateChange" name="ServiceOrderStateChangeNotification" itemRef="_msgItem_ServiceOrderStateChange" />
  <!-- FIX root-cause 2026-08-03: dedicated "Sub" message for the self-echo catch event.
       Without this, throw (_A_THROW_SO_STATE_CHANGE) and catch (_O_CATCH_SO_STATE_CHANGE)
       shared the same message name "ServiceOrderStateChangeNotification", which Kogito
       resolves to the SAME channel already claimed as outgoing -> the catch event's
       generated incoming channel had "no downstream" and never fired (see
       mp.messaging.incoming.ServiceOrderStateChangeNotificationSub in application.properties,
       which was configured but orphaned until this message existed). -->
  <message id="_msg_ServiceOrderStateChangeSub" name="ServiceOrderStateChangeNotificationSub" itemRef="_msgItem_ServiceOrderStateChangeSub" />
  <message id="_msg_BillingTrigger" name="BillingTrigger" itemRef="_msgItem_BillingTrigger" />
  <message id="_msg_WorkOrderCompleted" name="WorkOrderStateChange" itemRef="_msgItem_WorkOrderCompleted" />
  <message id="_msg_BillingActivated" name="BillingActivated" itemRef="_msgItem_BillingActivated" />
  <message id="_msg_ActivationNotified" name="ActivationNotified" itemRef="_msgItem_ActivationNotified" />
  <!-- FIX root-cause 2026-08-03: same collision as above, second occurrence. Throw
       (_O_THROW_ACTIVATION_NOTIFIED) and catch (_C_CATCH_ACTIVATION) shared
       "ActivationNotified" -> catch event's incoming channel ("ActivationNotifiedSub"
       in application.properties) had no downstream, node stayed Active forever. -->
  <message id="_msg_ActivationNotifiedSub" name="ActivationNotifiedSub" itemRef="_msgItem_ActivationNotifiedSub" />
  <message id="_msg_DossierClosed" name="DossierClosed" itemRef="_msgItem_DossierClosed" />

  <!-- ===== SIGNAUX INTERNES (synchro intra-instance, scope processInstance) ===== -->
  <signal id="_signal_ServiceOrderCompletedInternal" name="ServiceOrderCompletedInternal" structureRef="java.lang.String" />
  <signal id="_signal_BillingActivatedInternal" name="BillingActivatedInternal" structureRef="java.lang.String" />
  <signal id="_signal_ActivationNotifiedInternal" name="ActivationNotifiedInternal" structureRef="java.lang.String" />
  <signal id="_signal_DossierClosedInternal" name="DossierClosedInternal" structureRef="java.lang.String" />

  <!-- ===== SIGNALS ===== -->
  <signal id="_sig_RdvProposed" name="RdvProposedSignal" structureRef="_rdvProposedPayloadItem" />

  <!-- ===== ERRORS ===== -->
  <error id="ERR_BILLING_ACCOUNT" errorCode="com.telcom.ota.process.error.BillingAccountException" />
  
  <error id="ERR_ORDER" errorCode="com.telcom.ota.process.error.OrderException" />
  <error id="ERR_NETWORK_PROV" errorCode="com.telcom.ota.process.error.NetworkProvisioningException" />
  <error id="ERR_SERVICE_CHECK" errorCode="com.telcom.ota.process.error.ServiceVerificationException" />
  <error id="ERR_BILLING" errorCode="com.telcom.ota.process.error.BillingException" />
  <!--
    Un code d'erreur PAR tache faillible.

    jBPM ne retient qu'un gestionnaire par classe d'exception pour toute la
    portee du processus. Les cinq taches de facturation partageaient
    ERR_BILLING : le moteur signalait donc toujours la meme bordure — la
    derniere declaree — quelle que soit la tache en echec. Quatre bordures sur
    cinq etaient inertes, et quatre chemins de compensation avec elles.
  -->
  <error id="ERR_PAYMENT"         errorCode="com.telcom.ota.process.error.PaymentRegistrationException" />
  <error id="ERR_PRICING_TASK"    errorCode="com.telcom.ota.process.error.PricingException" />
  <error id="ERR_SUBSCRIPTION"    errorCode="com.telcom.ota.process.error.SubscriptionActivationException" />

  <!-- ===== COLLABORATION ===== -->
  <collaboration id="_collab" name="Order to Activate Fibre v12">
    <participant id="_pool" name="Operateur Telecom Activation Fibre" processRef="order_to_activate_v12" />
    <participant id="_pool_external_api" name="API Gateway Client externe" />
    <messageFlow id="_mf_order_submitted" name="POST orders API Gateway" sourceRef="_pool_external_api" targetRef="_START_ORDER_SUBMITTED" />
    <messageFlow id="_mf_workorder_completed" name="WorkOrderStateChange Kafka" sourceRef="_pool_external_api" targetRef="_A_CATCH_WORKORDER_COMPLETED" />
  </collaboration>

  <!-- ===== PROCESS ===== -->
  <process id="order_to_activate_v12" name="Order to Activate Fibre v12 TMF Forum Aligned" processType="Public" isExecutable="true" drools:packageName="com.telcom.ota" drools:version="12.0" drools:adHoc="false">
    
    <property id="orderId" itemSubjectRef="_orderIdItem" name="orderId" />
    <property id="taskNameVar" itemSubjectRef="_taskNameItem" name="taskNameVar" />
    <property id="installationAddress" itemSubjectRef="_installationAddressItem" name="installationAddress" />
    <property id="customerId" itemSubjectRef="_customerIdItem" name="customerId" />
    <property id="subscriptionId" itemSubjectRef="_orderIdItem" name="subscriptionId" />
    <property id="orderStatus" itemSubjectRef="_orderStatusItem" name="orderStatus" />
    <property id="workOrderId" itemSubjectRef="_workOrderIdItem" name="workOrderId" />
    <property id="quoteId" itemSubjectRef="_quoteIdItem" name="quoteId" />
    <property id="serviceOrderId" itemSubjectRef="_serviceOrderIdItem" name="serviceOrderId" />
    <property id="productOrderId" itemSubjectRef="_productOrderIdItem" name="productOrderId" />
    <property id="orderCreatedPayload" itemSubjectRef="_orderCreatedPayloadItem" name="orderCreatedPayload" />
    <property id="rejectionReasons" itemSubjectRef="_rejectionReasonsItem" name="rejectionReasons" />
    <property id="quoteProposedPayload" itemSubjectRef="_quoteProposedPayloadItem" name="quoteProposedPayload" />
    <property id="rdvConfirmed" itemSubjectRef="_rdvConfirmedItem" name="rdvConfirmed" />
    <property id="troubleTicketId" itemSubjectRef="_troubleTicketIdItem" name="troubleTicketId" />
    <property id="retryCount" itemSubjectRef="_retryCountItem" name="retryCount" />
    <property id="billingRetryCount" itemSubjectRef="_retryCountItem" name="billingRetryCount" />
    <property id="slaDueDate" itemSubjectRef="_slaDueDateItem" name="slaDueDate" />
    <property id="slaDuration" itemSubjectRef="_slaDurationItem" name="slaDuration" />
    <property id="requestId" itemSubjectRef="_requestIdItem" name="requestId" />
    <property id="technicianId" itemSubjectRef="_technicianIdItem" name="technicianId" />
    <property id="rdvSlot" itemSubjectRef="_rdvSlotItem" name="rdvSlot" />
    <property id="billingAccountId" itemSubjectRef="_billingAccountIdItem" name="billingAccountId" />
    <property id="billingActivatedPayload" itemSubjectRef="_billingActivatedPayloadItem" name="billingActivatedPayload" />
    <property id="eligibilityResult" itemSubjectRef="_eligibilityResultItem" name="eligibilityResult" />
    <property id="feasibilityResult" itemSubjectRef="_feasibilityResultItem" name="feasibilityResult" />
    <property id="offerId" itemSubjectRef="_offerIdItem" name="offerId" />
    <property id="commitmentMonths" itemSubjectRef="_commitmentMonthsItem" name="commitmentMonths" />
    <property id="cancelReason" itemSubjectRef="_cancelReasonItem" name="cancelReason" />
    <property id="offerValidationResult" itemSubjectRef="_offerValidationResultItem" name="offerValidationResult" />
    <property id="orderValidationResult" itemSubjectRef="_orderValidationResultItem" name="orderValidationResult" />
    <property id="workOrderResult" itemSubjectRef="_workOrderResultItem" name="workOrderResult" />
    <property id="quoteDecision" itemSubjectRef="_quoteDecisionItem" name="quoteDecision" />
    <property id="npsScore" itemSubjectRef="_npsScoreItem" name="npsScore" />
    <property id="satisfactionComment" itemSubjectRef="_npsCommentItem" name="satisfactionComment" />
    <property id="appointmentId" itemSubjectRef="_appointmentIdItem" name="appointmentId" />
    <property id="rdvProposedPayload" itemSubjectRef="_rdvProposedPayloadItem" name="rdvProposedPayload" />
    <property id="rdvConfirmedPayload" itemSubjectRef="_msgItem_RdvConfirmed" name="rdvConfirmedPayload" />
    <!-- La charge utile de soumission a sa propre variable.
         Le message de demarrage etait ecrit dans `orderId` : l'identifiant de la
         commande portait donc tout l'evenement, et le restait jusqu'a la fin du
         parcours. `_Q_TASK_LOAD_ELIGIBILITY` reecrivait bien un `orderId` propre,
         sans effet — la variable etait a la fois SON entree et SA sortie, et
         l'ecriture n'aboutissait pas la ou celles de `customerId` et `offerId`
         aboutissaient. Chaque handler devait donc redesserialiser defensivement,
         et l'oubli de cette precaution a deja casse la replanification une fois.
         Quatrieme occurrence du meme defaut apres les deux evenements de RDV. -->
    <property id="orderSubmittedPayload" itemSubjectRef="_msgItem_OrderSubmitted" name="orderSubmittedPayload" />
    <property id="serviceOrderCompletedPayload" itemSubjectRef="_serviceOrderCompletedPayloadItem" name="serviceOrderCompletedPayload" />
    <property id="activationNotifiedPayload" itemSubjectRef="_activationNotifiedPayloadItem" name="activationNotifiedPayload" />
    <property id="dossierClosedPayload" itemSubjectRef="_dossierClosedPayloadItem" name="dossierClosedPayload" />
    <property id="confirmedMonthlyPrice" itemSubjectRef="_monthlyPriceItem" name="confirmedMonthlyPrice" />
    <property id="firstMonthAmount" itemSubjectRef="_monthlyPriceItem" name="firstMonthAmount" />
    <!-- Frais d'acces reellement dus, apres exoneration ou remise. Ils etaient
         calcules par billing-pricing.drl puis perdus faute de sortie declaree :
         la premiere facture ne portait que le prorata mensuel. -->
    <property id="setupFeeCharged" itemSubjectRef="_monthlyPriceItem" name="setupFeeCharged" />
    <property id="serviceId" itemSubjectRef="_serviceIdItem" name="serviceId" />
    <property id="resourceId" itemSubjectRef="_resourceIdItem" name="resourceId" />
    <property id="quoteAcceptedPayload" itemSubjectRef="_quoteAcceptedPayloadItem" name="quoteAcceptedPayload" />
    <property id="quoteRejectedPayload" itemSubjectRef="_quoteRejectedPayloadItem" name="quoteRejectedPayload" />
    <property id="workOrderResultPayload" itemSubjectRef="_workOrderResultPayloadItem" name="workOrderResultPayload" />
    
    <property id="paymentRegistered" itemSubjectRef="_paymentRegisteredItem" name="paymentRegistered" />
    <property id="pricingApplied" itemSubjectRef="_pricingAppliedItem" name="pricingApplied" />

<property id="firstInvoiceId" itemSubjectRef="_firstInvoiceIdItem" name="firstInvoiceId" />
    <!-- ===== LANES ===== -->
    <laneSet id="_laneSet">
      <lane id="_L_BILLING" name="Billing Service TMF666 676">
        <flowNodeRef>_B_COMP_BILLING_ACCOUNT</flowNodeRef>
