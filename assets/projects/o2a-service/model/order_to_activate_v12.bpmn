  <dataOutputAssociation>
    <sourceRef>_B_TASK_APPLY_OFFER_PRICING_DRL_pricingAppliedOutput</sourceRef>
    <targetRef>pricingApplied</targetRef>
  </dataOutputAssociation>
</task>

    <exclusiveGateway id="_B_GW_PAYMENT_MERGE" name="Premiere tentative ou relance" gatewayDirection="Converging">
