    <!-- ===== SCRIPT TASK FOR QUOTE PAYLOAD ===== -->
    <scriptTask id="_Q_TASK_BUILD_ACCEPTED_PAYLOAD" name="Build Quote payload" scriptFormat="http://www.java.com/java">
      <script><![CDATA[
        java.util.Map<String, Object> payload = new java.util.HashMap<>();
        payload.put("orderId", kcontext.getVariable("orderId"));
        payload.put("customerId", kcontext.getVariable("customerId"));
        payload.put("offerId", kcontext.getVariable("offerId"));
        payload.put("quoteId", kcontext.getVariable("quoteId"));
        payload.put("paymentMethod", kcontext.getVariable("paymentMethod") != null ? 
            kcontext.getVariable("paymentMethod") : "CB");
        payload.put("commitmentMonths", kcontext.getVariable("commitmentMonths") != null ? 
            kcontext.getVariable("commitmentMonths") : 24);
        payload.put("installationAddress", kcontext.getVariable("installationAddress"));
        
        String json = new com.fasterxml.jackson.databind.ObjectMapper()
            .writeValueAsString(payload);
        kcontext.setVariable("quoteAcceptedPayload", json);
        kcontext.setVariable("quoteRejectedPayload", json);
      ]]></script>
      <incoming>Flow_1beu1ke</incoming>
      <outgoing>Flow_after_build</outgoing>
    </scriptTask>

