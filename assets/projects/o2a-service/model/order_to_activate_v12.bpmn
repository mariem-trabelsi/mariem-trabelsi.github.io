        <outputSet><dataOutputRefs>_A_CATCH_WORKORDER_COMPLETED_msgOutput</dataOutputRefs></outputSet>
      </ioSpecification>
      <dataOutputAssociation><sourceRef>_A_CATCH_WORKORDER_COMPLETED_msgOutput</sourceRef><targetRef>workOrderResultPayload</targetRef></dataOutputAssociation>
      <messageEventDefinition messageRef="_msg_WorkOrderCompleted" />
    </intermediateCatchEvent>

    <!-- FIX (root-cause, 2026-08-05): checkpoint/yield point. A near-instant
         timer (PT1S) forces Kogito to persist process state right here and
         resume the downstream chain (Extraire workOrderResult -> Provisionner
         reseau -> Verifier activation -> Mettre a jour inventaires ->
         Creer compte facturation -> ...) via the jobs-management addon on a
         fresh unit of work, instead of continuing synchronously inside the
         same call stack that delivered the WorkOrderStateChange CloudEvent.
         This is what actually stops the "null source" reentrancy exception
         and the resulting unmarshallable-work-item persistence failure;
         see the _sA09 comment above for the full explanation. -->

    

