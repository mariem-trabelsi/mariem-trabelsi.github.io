        <flowNodeRef>_Q_TASK_LOAD_ELIGIBILITY</flowNodeRef>
        <flowNodeRef>_Q_TASK_CREATE_QUOTE</flowNodeRef>
        
        <flowNodeRef>_Q_TASK_BUILD_ACCEPTED_PAYLOAD</flowNodeRef>
      </lane>
      <lane id="_L_CLIENT" name="Portail Client Self Service">
        <flowNodeRef>_Q_TASK_UPDATE_QUOTE_ACCEPTED</flowNodeRef>
        <flowNodeRef>_Q_GW_FORK_AFTER_ACCEPT</flowNodeRef>
        <flowNodeRef>_C_THROW_DOSSIER_CLOSED</flowNodeRef>
        <flowNodeRef>_C_END_DOSSIER_CLOSED</flowNodeRef>
        <flowNodeRef>_C_CATCH_ACTIVATION</flowNodeRef>
        <flowNodeRef>_C_THROW_RDV_CONFIRMED</flowNodeRef>
        <flowNodeRef>_C_CATCH_RDV</flowNodeRef>
        <flowNodeRef>_C_SCRIPT_PARSE_RDV</flowNodeRef>
